datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String            @id @default(uuid())
  email     String            @unique
  password  String
  credits   Int               @default(1000)
  createdAt DateTime          @default(now())
  histories DocumentHistory[]
}

model DocumentHistory {
  id                  String   @id @default(uuid())
  filename            String
  tone                String
  originalAiScore     Int
  humanizedHumanScore Int
  blocksJson          String // Serialized JSON string of the DocBlocks
  createdAt           DateTime @default(now())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
